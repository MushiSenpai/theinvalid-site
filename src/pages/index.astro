---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { repoStatuses, ago } from '../lib/github.js';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const building = projects.filter((p) => p.data.status === 'building');
const shipped = projects.filter((p) => p.data.status === 'shipped');

// Build-time GitHub snapshot (fail-soft); a scheduled rebuild keeps it fresh.
const gh = await repoStatuses(projects.map((p) => p.data.repo));

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base>
  <section class="hero">
    <p class="called">$ they called me invalid_</p>
    <h1 class="thisisme">This is <span class="accent">me</span>.</h1>
    <p class="sub">
      I'm <strong>Madhan Kumar Reddy</strong> — an AI Infrastructure Operator in
      Singapore. <strong>I build private, on-premises AI systems that never send
      your data to the cloud</strong> — for firms that need AI but can't hand
      sensitive data to OpenAI or Anthropic.
    </p>
    <p class="sub">
      No code hand-written: I spec, direct LLMs, and verify. Everything below is
      public, operating daily, and documented — benchmarks, failures, and all.
    </p>
    <p class="sub">
      <strong><a href="/start-here">New here? Start with the plain-English version →</a></strong>
    </p>
    <p class="sub">
      <a href="/services">Work with me</a> · <a href="/projects">Projects</a> ·
      <a href="/calculator">Field guide</a> · <a href="/blog">Knowledge base</a> ·
      <a href="/resume">Résumé</a> · <a href="https://github.com/MushiSenpai">GitHub</a>
    </p>
  </section>

  <h2>Now building</h2>
  {building.map((p) => (
    <article class="card">
      <h3><a href={`/projects/${p.id}`}>{p.data.title}</a> <span class="badge building">building</span></h3>
      <p class="oneliner">{p.data.oneliner}</p>
      <p class="meta">
        <span>{p.data.stack.slice(0, 4).join(' · ')}</span>
        {gh.get(p.data.repo)?.pushedAt && <span>updated {ago(gh.get(p.data.repo).pushedAt)}</span>}
        <a href={p.data.repo}>repo ↗</a>
      </p>
    </article>
  ))}

  <h2>Operating daily</h2>
  {shipped.map((p) => (
    <article class="card">
      <h3><a href={`/projects/${p.id}`}>{p.data.title}</a> <span class="badge shipped">shipped</span></h3>
      <p class="oneliner">{p.data.oneliner}</p>
      <p class="meta">
        <span>{p.data.stack.slice(0, 4).join(' · ')}</span>
        {gh.get(p.data.repo)?.pushedAt && <span>updated {ago(gh.get(p.data.repo).pushedAt)}</span>}
        <a href={p.data.repo}>repo ↗</a>
      </p>
    </article>
  ))}

  <h2>Latest from the blog</h2>
  <ul class="postlist">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
