---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { repoStatuses, ago } from '../../lib/github.js';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const gh = await repoStatuses(projects.map((p) => p.data.repo).filter(Boolean));
---

<Base title="Projects — theinvalid.me">
  <h1>Projects</h1>
  <p style="color: var(--muted)">
    Four infrastructure stacks and the products built on them. Every repo is
    public; statuses are honest — <code>building</code> means building.
  </p>
  <p style="margin:1.3rem 0 0.4rem">
    <a class="btn" href="/workflow-catalogue.html">Live workflow catalogue ↗</a>
    <a class="btn" href="/3d-catalogue">3D asset catalogue ↗</a>
  </p>
  <p class="meta" style="margin:0 0 1.6rem">Every creative workflow with real measured benchmarks, auto-refreshed monthly — plus the 3D asset foundry's own catalogue.</p>
  {projects.map((p) => (
    <article class="card">
      <h3>
        <a href={`/projects/${p.id}`}>{p.data.title}</a>
        <span class={`badge ${p.data.status}`}>{p.data.status}</span>
      </h3>
      <p class="oneliner">{p.data.oneliner}</p>
      <p class="meta">
        <span>{p.data.stack.join(' · ')}</span>
        {gh.get(p.data.repo)?.pushedAt && <span>updated {ago(gh.get(p.data.repo).pushedAt)}</span>}
        {p.data.repo && <a href={p.data.repo}>repo ↗</a>}
        {p.data.caseStudy && <a href={p.data.caseStudy}>case study →</a>}
      </p>
    </article>
  ))}
</Base>
