---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: '2-digit' });

// Compact case-study index. Full prose lives on the linked pages; this list
// is built to be skimmed in seconds (feedback 2026-07-12: nine full cards
// buried the blog).
const cases = [
  {
    title: 'I built a quantum ML lab. The honest answer: quantum mostly ties or loses today',
    outcome:
      'Reproduced a published quantum advantage (0.900 vs 0.730), then <strong>erased it three ways</strong>: a fairly tuned classical model beat it, dequantization matched it, device noise took the rest. Eleven experiments, two real QPUs, zero manufactured wins.',
    meta: 'PennyLane / Qiskit · 11 experiments vs classical baselines · ibm_fez + ionq forte-1 · barren plateau measured at 1,436×',
    link: '/case-studies-honest-qml-lab/',
    linkLabel: 'full case study',
    subject: 'Quantum feasibility assessment',
    flagship: true,
  },
  {
    title: 'One product photo → a marketplace-ready 3D model + a compliance report',
    outcome:
      'Five real SKUs on one RTX 5090: three passed clean, <strong>one refused, one flagged with the exact miss</strong> (703mm reconstructed vs 650mm listed). The gate stopping bad assets is the product.',
    meta: 'TRELLIS.2 / Hunyuan3D · headless Blender · compliance gate · 63–154s per SKU · zero cloud',
    link: '/case-studies-product-photo-to-3d/',
    linkLabel: 'full case study',
    subject: '3D assets for my product catalogue',
    flagship: true,
  },
  {
    title: 'One shot list → an Unreal-ready previs pack in 15 minutes',
    outcome:
      'Six props (4 photos + 2 text briefs): <strong>five delivered in 15m12s warm, one refused with its reason shown</strong>. One idempotent Unreal import script, Nanite on heroes only. Tested in Unreal Engine 5.8.',
    meta: 'text/photo → 3D · per-tier mesh chain · FBX + GLB · zero cloud',
    link: '/case-studies-shot-list-to-previs-pack/',
    linkLabel: 'full case study',
    subject: 'Previs assets for my production',
  },
  {
    title: 'A sovereign LLM that physically can’t leak',
    outcome:
      'vLLM + Nemotron with routing-enforced privacy: the client profile <strong>refuses to fall back to cloud</strong>, failing loudly instead of degrading silently. Operated daily at up to 268 tok/s, 180K context.',
    meta: 'vLLM · Nemotron · Tailscale-only · default-deny firewall',
    link: '/projects/sovereign-ai-stack',
    linkLabel: 'the stack',
    subject: 'Private LLM deployment',
  },
  {
    title: 'Auditing a private codebase for vulnerabilities, fully air-gapped',
    outcome:
      'Hybrid system beats the LLM alone, <strong>0.97 vs 0.90</strong>, and the cross-file taint engine hits 1.00 precision where a per-file LLM gets 0.25. Honest headline: the fine-tune added ~0 detection capability, and measuring that caught 4 of my own eval bugs.',
    meta: 'cross-file taint · Semgrep OSS · Qwen2.5-Coder QLoRA · runs under --network=none',
    link: '/projects/sovereign-code-auditor',
    linkLabel: 'the auditor',
    subject: 'Air-gapped code security audit',
  },
  {
    title: 'A talking-head avatar from a photo and a voice sample, three quality tiers',
    outcome:
      'For a 34.5s narration, measured: <strong>MuseTalk 78s, LatentSync 242s, Hallo2 1197s</strong>. Honest ceiling: social-grade; broadcast close-ups still go to a cloud path, and I say so up front.',
    meta: 'Fish Speech clone · 3 lip-sync engines, isolated + pinned · zero cloud',
    link: '/blog/i-benchmarked-an-ai-avatar-pipeline-end-to-end',
    linkLabel: 'full write-up',
    subject: 'Local avatar pipeline',
  },
  {
    title: 'Removing an object from production footage',
    outcome:
      '<strong>Clean removal in 180 seconds</strong>, no ghost, background reconstructed. On a worst-case clip (glassware, low light) it leaves a residue, and clients hear that up front with a free sample frame.',
    meta: 'VOID · SAM3 · SeedVR2 4K finish · failures shown',
    link: '/blog/object-removal-arc',
    linkLabel: 'full write-up',
    subject: 'Object removal for my footage',
  },
  {
    title: 'Starving a diffusion model of room to hallucinate',
    outcome:
      'A vision LLM writes the scene constraints itself before any diffusion runs: <strong>203 seconds end to end, unattended</strong>, 16 mask targets including 13 dependent reflections and shadows. The known hard case (a liquid) did not disappear, and that boundary is named.',
    meta: 'Nemotron 3-pass forensic scan · SAM3 · VOID/VACE',
    link: '/blog/the-forensic-bridge-measure-the-scene-before-diffusion-touches-it',
    linkLabel: 'full write-up',
    subject: 'Constrained AI video edits',
  },
  {
    title: 'Comic page → narrated video, fully local',
    outcome:
      'Panel detection, cloned character voices, narrator on captions, 2.5D parallax camera. <strong>Runs end to end</strong>; in active hardening on real series pages, hard problems documented as they’re solved.',
    meta: 'vision LLM · OpenCV · Fish Speech · ffmpeg · zero cloud',
    link: '/projects/comic-narrator',
    linkLabel: 'the project',
    subject: 'Comic-to-video pipeline',
  },
];

const mail = (subject: string) =>
  `mailto:reddy.madhankumar.sg@gmail.com?subject=${encodeURIComponent(subject)}`;
---

<Base
  title="Knowledge base: case studies, the failure log & the field guide — theinvalid.me"
  description="Case studies, the failure log (decisions and what they cost), and an interactive field guide to running LLMs locally: the build log of a sovereign AI stack, failures included."
>
  <h1>Knowledge base</h1>
  <p style="color: var(--muted)">
    Everything I've learned building a sovereign AI stack, in public: the proof
    (case studies), the failure log (dead ends written up because they were the
    expensive part), and the interactive field guide.
  </p>

  <nav class="jumpbar" aria-label="Sections on this page">
    <span>jump to:</span>
    <a href="#case-studies">case studies</a>
    <a href="#blog">the failure log</a>
    <a href="/blog/topics">by topic</a>
    <a href="/calculator">field guide</a>
  </nav>

  <article class="card" style="border-color: var(--accent)">
    <h3>📐 <a href="/calculator">The local-AI field guide</a></h3>
    <p class="oneliner">Interactive: what actually fits in your VRAM, what runs on each GPU tier, how many users one card serves, and when local beats cloud.</p>
    <p class="meta">measured on an RTX 5090 · every number editable · <a href="/calculator">open the field guide →</a></p>
  </article>

  <h2 id="case-studies">Case studies</h2>
  <p style="color:var(--muted)">
    Problem → solution → outcome, compressed to the result. Built and measured
    on my own stack: where a number is from a real run I say so, and where
    something didn't work I say that too. Each links to the full story.
  </p>

  {cases.map((c) => (
    <article class="card" style={c.flagship ? 'border-color: var(--accent)' : undefined}>
      <h3>{c.title}</h3>
      <p set:html={c.outcome} />
      <p class="meta">
        <span>{c.meta}</span>
        <a href={c.link}>{c.linkLabel} →</a>
        <a href={mail(c.subject)}>want this? email me →</a>
      </p>
    </article>
  ))}

  <p style="margin-top:1.5rem">
    <a href="/services">→ What this costs and how to start</a>
  </p>

  <h2 id="blog">The failure log</h2>
  <p style="color: var(--muted)">
    New posts as the work happens.
    <span style="font-family: var(--mono); font-size: 0.9rem">
      Looking for something specific? <a href="/blog/topics"><strong>Browse by topic →</strong></a>
      (LLM serving, GPU/VRAM, quantum, creative AI, audio, ops…)
    </span>
  </p>
  <ul class="postlist">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <span>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <br /><span style="color: var(--muted); font-size: 0.9rem">{post.data.description}</span>
        </span>
      </li>
    ))}
  </ul>

  <Contact subject="Private AI for my team" lead="Have a problem like these?" />
</Base>
