---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base title="Blog — theinvalid.me" description="Failures, decisions, and what they cost — the build log of a sovereign AI stack.">
  <h1>The failure log</h1>
  <p style="color: var(--muted)">
    Why abandoned plans get written up: the dead ends were the expensive part,
    so they're the valuable part. New posts as the work happens.
  </p>
  <p style="font-family: var(--mono); font-size: 0.9rem">
    Looking for something specific? <a href="/blog/topics"><strong>Browse by topic →</strong></a>
    <span style="color: var(--muted)"> — every post grouped by technology (LLM serving, GPU/VRAM, creative AI, audio, ops…).</span>
  </p>
  <ul class="postlist">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <span>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <br /><span style="color: var(--muted); font-size: 0.9rem">{post.data.description}</span>
        </span>
      </li>
    ))}
  </ul>
</Base>
