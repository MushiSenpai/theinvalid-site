---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'theinvalid — Madhan Kumar Reddy',
  description = 'AI Infrastructure Operator. I spec, direct LLMs, and verify. Sovereign local LLM, video and audio stacks on an RTX 5090 — all public, benchmarks and failures included.',
} = Astro.props;

const path = Astro.url.pathname;
const current = (p: string) =>
  (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="theinvalid blog" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, 'https://theinvalid.me').href} />
    <meta property="og:image" content="https://theinvalid.me/og-image.png" />
    <meta property="og:site_name" content="theinvalid.me" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://theinvalid.me/og-image.png" />
  </head>
  <body>
    <nav class="site">
      <a class="brand" href="/">theinvalid<span style="color: var(--accent)">.me</span></a>
      <a href="/start-here" aria-current={current('/start-here')}>start here</a>
      <a href="/services" aria-current={current('/services')}>work with me</a>
      <a href="/projects" aria-current={current('/projects')}>projects</a>
      <a href="/calculator" aria-current={current('/calculator')}>field guide</a>
      <a href="/blog" aria-current={current('/blog')}>knowledge base</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>
        Built by directing LLMs against specs — <a href="/resume#how-i-work--read-this-first">here's exactly how</a>.
        No trackers, no cookies, no JavaScript frameworks.
      </p>
      <p>
        © 2026 Madhan Kumar Reddy ·
        <a href="https://github.com/MushiSenpai" rel="me" aria-label="GitHub: MushiSenpai">
          <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" style="vertical-align:-0.15em;fill:currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          MushiSenpai</a> ·
        <a href="https://www.linkedin.com/in/reddymk/">LinkedIn</a> ·
        <a href="/rss.xml">RSS</a>
      </p>
    </footer>
  </body>
</html>
